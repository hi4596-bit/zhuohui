# Normalize line endings so Windows checkouts behave identically.
# Batch files MUST be CRLF or cmd.exe will not run them.

* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.py   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.avif binary
*.zip  binary
